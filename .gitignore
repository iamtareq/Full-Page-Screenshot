# Never commit private / signing material
*.pem
*.key
*.p12

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Generated per-machine by install-updater.cmd. It MUST stay on disk (the native-host
# registry entry points at it), but it is not repo content - and if it were left
# untracked it would make `git status` permanently dirty, which used to block updates.
updater/com.fpc.updater.json
